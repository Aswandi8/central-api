generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BANNED
}

enum RoleScope {
  GLOBAL
  WEBSITE
}

enum WebsiteStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum VideoStatus {
  DRAFT
  PROCESSING
  READY
  PUBLISHED
  ARCHIVED
}

enum Visibility {
  PUBLIC
  PRIVATE
  UNLISTED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  PUBLISH
  UNPUBLISH
  LOGIN
  LOGOUT
  FAILED_LOGIN
  PASSWORD_CHANGE
  ROLE_ASSIGN
  ROLE_REMOVE
  PERMISSION_GRANT
  PERMISSION_REVOKE
}

enum ApiClientStatus {
  ACTIVE
  INACTIVE
  REVOKED
}

enum ShortLinkStatus {
  ACTIVE
  INACTIVE
}

enum ShortLinkPreviewType {
  IMAGE
  VIDEO
}

enum ShortLinkVisitorType {
  HUMAN
  CRAWLER
  BOT
  UNKNOWN
}

// ============================================================
// BETTER AUTH
// ============================================================

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  status UserStatus @default(ACTIVE)

  sessions Session[]
  accounts Account[]

  globalRoles UserRole[]

  websiteRoles UserWebsiteRole[]

  auditLogs AuditLog[]

  invitations UserInvitation[] @relation("InvitationUser")

  sentInvitations UserInvitation[] @relation("InvitationInviter")

  createdShortLinks ShortLink[] @relation("ShortLinkCreatedBy")

  role       String?
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  @@unique([email])
  @@index([status])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId], map: "account_issuer_accountId_uidx")
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ============================================================
// USER INVITATION
// ============================================================

model UserInvitation {
  id String @id @default(cuid())

  userId String?
  user   User? @relation("InvitationUser", fields: [userId], references: [id], onDelete: Cascade)

  name  String
  email String

  websiteId String
  website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  roleId String
  role   Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  tokenHash String @unique

  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?

  invitedById String?
  invitedBy   User? @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([websiteId])
  @@index([roleId])
  @@index([email])
  @@index([invitedById])
  @@index([expiresAt])
  @@index([usedAt])
  @@index([revokedAt])
  @@index([userId, websiteId])
  @@index([websiteId, roleId])
  @@map("user_invitation")
}

// ============================================================
// ROLE & PERMISSION
// ============================================================

model Role {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  scope       RoleScope @default(WEBSITE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  globalUsers UserRole[]

  websiteUsers UserWebsiteRole[]

  rolePermissions RolePermission[]

  invitations UserInvitation[]

  @@index([scope])
  @@map("role")
}

model Permission {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions RolePermission[]

  @@map("permission")
}

// ============================================================
// GLOBAL USER ROLE
// ============================================================

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_role")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permission")
}

// ============================================================
// WEBSITE
// ============================================================

model Website {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  domain      String?       @unique
  status      WebsiteStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userRoles UserWebsiteRole[]

  invitations UserInvitation[]

  videos     VideoWebsite[]
  categories Category[]

  views View[]

  apiClients ApiClient[]

  auditLogs AuditLog[]

  @@index([status])
  @@map("website")
}

// ============================================================
// WEBSITE-SCOPED USER ROLE
// ============================================================

model UserWebsiteRole {
  userId    String
  websiteId String
  roleId    String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, websiteId])
  @@index([websiteId])
  @@index([roleId])
  @@index([websiteId, roleId])
  @@map("user_website_role")
}

// ============================================================
// CATEGORY
// ============================================================

model Category {
  id        String @id @default(cuid())
  websiteId String

  name        String
  slug        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  website Website         @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  videos  VideoCategory[]

  @@unique([websiteId, slug])
  @@index([websiteId])
  @@map("category")
}

// ============================================================
// VIDEO
// ============================================================

model Video {
  id          String  @id @default(cuid())
  title       String
  slug        String  @unique
  description String?
  thumbnail   String?

  videoUrl   String?
  streamUrl  String?
  storageKey String?

  duration Int?

  status     VideoStatus @default(DRAFT)
  visibility Visibility  @default(PUBLIC)

  metadata Json?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  websites   VideoWebsite[]
  categories VideoCategory[]
  views      View[]

  @@index([status])
  @@index([visibility])
  @@index([publishedAt])
  @@map("video")
}

model VideoWebsite {
  videoId   String
  websiteId String

  title      String?
  slug       String
  visibility Visibility @default(PUBLIC)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  video   Video   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@id([videoId, websiteId])
  @@unique([websiteId, slug])
  @@index([websiteId])
  @@map("video_website")
}

model VideoCategory {
  videoId    String
  categoryId String

  video    Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([videoId, categoryId])
  @@index([categoryId])
  @@map("video_category")
}

// ============================================================
// VIEW / ANALYTICS
// ============================================================

model View {
  id String @id @default(cuid())

  videoId   String
  websiteId String

  visitorId String?

  watchDuration Int?
  completed     Boolean @default(false)

  userAgent String?

  createdAt DateTime @default(now())

  video   Video   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([videoId])
  @@index([websiteId])
  @@index([createdAt])
  @@index([videoId, websiteId, createdAt])
  @@map("view")
}

// ============================================================
// SHORTLINK
// ============================================================

model ShortLink {
  id             String               @id @default(cuid())
  slug           String               @unique
  destinationUrl String
  status         ShortLinkStatus      @default(ACTIVE)
  previewType    ShortLinkPreviewType

  title       String?
  description String?

  thumbnailUrl       String?
  thumbnailWidth     Int?
  thumbnailHeight    Int?
  thumbnailMimeType  String?
  thumbnailSizeBytes Int?

  previewVideoUrl        String?
  previewVideoWidth      Int?
  previewVideoHeight     Int?
  previewVideoDurationMs Int?
  previewVideoMimeType   String?
  previewVideoSizeBytes  Int?

  showPlayButton  Boolean @default(false)
  displayDuration String?

  clickCount Int @default(0)

  createdById String?
  createdBy   User? @relation("ShortLinkCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  clicks ShortLinkClick[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([previewType])
  @@index([createdById])
  @@index([createdAt])
  @@map("short_link")
}

model ShortLinkClick {
  id          String               @id @default(cuid())
  shortLinkId String
  visitorType ShortLinkVisitorType @default(UNKNOWN)

  ipHash    String?
  referrer  String?
  userAgent String?

  country String?
  device  String?
  browser String?
  os      String?

  clickedAt DateTime @default(now())

  shortLink ShortLink @relation(fields: [shortLinkId], references: [id], onDelete: Cascade)

  @@index([shortLinkId])
  @@index([clickedAt])
  @@index([shortLinkId, clickedAt])
  @@index([shortLinkId, visitorType, clickedAt])
  @@index([shortLinkId, ipHash])
  @@map("short_link_click")
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id String @id @default(cuid())

  userId    String?
  websiteId String?

  action AuditAction

  entity   String
  entityId String?

  metadata Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  website Website? @relation(fields: [websiteId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([websiteId])
  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

// ============================================================
// CENTRAL API CLIENT
// ============================================================

model ApiClient {
  id        String @id @default(cuid())
  websiteId String

  name        String
  description String?

  keyHash String @unique

  status ApiClientStatus @default(ACTIVE)

  lastUsedAt DateTime?
  expiresAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
  @@index([status])
  @@map("api_client")
}